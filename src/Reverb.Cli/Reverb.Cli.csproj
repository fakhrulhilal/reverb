<Project Sdk="Microsoft.NET.Sdk">
  <!-- The `reverb` command. Also hosts the kernel process (`reverb __kernel`). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>reverb</ToolCommandName>
    <PackageId>Reverb.Notebooks</PackageId>
    <Description>Reactive C# notebooks that are plain .cs files.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <!-- nuget.org renders plain Markdown only: no HTML, and images from a short list of hosts. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reverb.Server\Reverb.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Reverb.Kernel.Tests" />
    <InternalsVisibleTo Include="Reverb.Server.Tests" />
  </ItemGroup>
</Project>
