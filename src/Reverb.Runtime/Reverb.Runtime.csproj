<Project Sdk="Microsoft.NET.Sdk">
  <!-- Referenced by every notebook. Keep it small and free of dependencies. -->
  <PropertyGroup>
    <RootNamespace>Reverb</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Reverb.Runtime</PackageId>
    <Description>Display helpers and UI widgets for Reverb notebooks.</Description>
    <IsAotCompatible>false</IsAotCompatible>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
